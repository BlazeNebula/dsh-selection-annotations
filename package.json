{
  "name": "@u2a5f/dsh-selection-annotations",
  "version": "1.2.0",
  "description": "DeepSeek Harness 批注插件：在 Web 界面里选中文字加批注，随消息一起发送；批注是独立的 JSON 数据块，不会混进消息正文。DSH plugin: select text in the Web UI to annotate it, and send the whole set with your message as a separate JSON content block — never mixed into your message text.",
  "type": "module",
  "license": "MIT",
  "author": "U2A5F <U2A5F@outlook.com>",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "annotation",
    "selection",
    "quote",
    "web"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "src",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check:build": "node scripts/check-build.mjs",
    "test": "node scripts/check-build.mjs && node --import ./test/loader.mjs --test test/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2A5F/dsh-selection-annotations.git"
  },
  "homepage": "https://github.com/2A5F/dsh-selection-annotations#readme",
  "bugs": {
    "url": "https://github.com/2A5F/dsh-selection-annotations/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "devDependencies": {
    "esbuild": "^0.25.12"
  }
}
